# RPC endpoint for the chain the vault is deployed on.
RPC_URL=http://127.0.0.1:8545

# The agent's session key. Needs a little native gas token (to submit
# executeTrade) and a little of the session's spend asset held directly in
# this wallet (to pay the x402 resource server for quotes/data/routes) — NOT
# the vault's escrowed collateral, which this key can never withdraw.
AGENT_PRIVATE_KEY=0xyour_agent_session_private_key

VAULT_ADDRESS=0xyour_deployed_RoninVault_address
SESSION_ID=0

# Base URL of the Ronin402 x402 resource server.
SERVER_BASE_URL=http://127.0.0.1:8402

# The RWA token this session is authorized to acquire, and the venue it must
# be bought through — both must already be allowlisted on the session.
OUTPUT_TOKEN=0xyour_rwa_token_address
VENUE=0xyour_allowlisted_venue_address

# How much to spend this cycle, in the session's spend-token smallest units.
# Must be <= the session's maxPerTx.
SPEND_AMOUNT=50000000

SLIPPAGE_BPS=50
PAIR=USDC/TBILL

# Omit to run a single cycle and exit; set to loop forever on this interval.
# INTERVAL_SECONDS=300
