# RPC endpoint for the chain the payment asset and facilitator wallet live on.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Facilitator's own hot wallet — pays gas to settle transferWithAuthorization
# calls on behalf of payers. Needs native gas token but never touches the
# vault or holds user funds.
FACILITATOR_PRIVATE_KEY=0xyour_facilitator_private_key

# The EIP-3009-capable payment asset (e.g. a deployed MockUSDC for
# local/testnet, or production USDC on mainnet/Base).
ASSET_ADDRESS=0xyour_deployed_MockUSDC_address
ASSET_NAME=Mock USD Coin
ASSET_VERSION=1

# Address that receives payments for quotes/data/execution routes.
PAY_TO_ADDRESS=0xyour_revenue_address

# Free-form label included in the x402 payment requirements/payload.
NETWORK_LABEL=ronin402-devnet

# Prices, in the asset's smallest unit (e.g. 6 decimals for USDC-like tokens).
PRICE_QUOTE=1000
PRICE_DATA=2000
PRICE_EXECUTE=5000

PORT=8402
